# Emulated EVPN fabric scenario definition.
EGA_TOPOLOGY=emulated.clab.yml
EGA_INVENTORY="${EGA_INVENTORY:-inventory/emulated}"
# No Kubernetes API here: deploy the standalone VTEP; inventory peers drive the relay.
EGA_PLAYBOOKS="${EGA_PLAYBOOKS:-network.evpn_gateway_test.simulate network.evpn_gateway_test.deploy_workload network.evpn_gateway.deploy network.evpn_gateway_test.healthcheck}"
