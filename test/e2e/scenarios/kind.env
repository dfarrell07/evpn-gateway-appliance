# Kind EVPN scenario definition: the workload side is a real kind cluster
# (ovn-kubernetes + frr-k8s), so production peer discovery runs for real.
EGA_TOPOLOGY=kind.clab.yml
EGA_INVENTORY="${EGA_INVENTORY:-inventory/kind}"
EGA_PLAYBOOKS="${EGA_PLAYBOOKS:-network.evpn_gateway_test.simulate network.evpn_gateway.deploy}"
