{
  "uid": "ega-appliance",
  "title": "EGA appliance",
  "tags": [
    "ega"
  ],
  "schemaVersion": 39,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1
      },
      {
        "name": "job",
        "label": "Job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(node_network_info{device=~\"vxlan[0-9]+|wg0\"}, job)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(up{job=~\"$job\"}, instance)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "state-timeline",
      "title": "Node-exporter scrape",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Up",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"$job\", instance=~\"$instance\"}",
          "legendFormat": "{{job}}/{{instance}}"
        }
      ],
      "options": {
        "rowHeight": 0.8
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Device operstate",
      "description": "VXLAN and WireGuard devices can report unknown while carrying traffic.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "operstate"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "up": {
                        "color": "green",
                        "index": 0
                      },
                      "down": {
                        "color": "red",
                        "index": 1
                      },
                      "lowerlayerdown": {
                        "color": "red",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "sortBy": [
          {
            "displayName": "instance",
            "desc": false
          },
          {
            "displayName": "device",
            "desc": false
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_network_info{job=~\"$job\", instance=~\"$instance\", device=~\"vxlan[0-9]+|br-vni[0-9]+|trunk-br|trunk[.][0-9]+|wg0\"}",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "job",
                "instance",
                "device",
                "operstate",
                "adminstate"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "job": 0,
              "instance": 1,
              "device": 2,
              "operstate": 3,
              "adminstate": 4
            }
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "state-timeline",
      "title": "Device carrier",
      "description": "Down includes administratively down devices, whose carrier is unreadable. Sampled state can miss short flaps.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Up",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (job, instance, device) (node_network_carrier{job=~\"$job\", instance=~\"$instance\", device=~\"vxlan[0-9]+|br-vni[0-9]+|trunk-br|trunk[.][0-9]+|wg0\"}) or on(job, instance, device) 0 * max by (job, instance, device) (node_network_info{job=~\"$job\", instance=~\"$instance\", device=~\"vxlan[0-9]+|br-vni[0-9]+|trunk-br|trunk[.][0-9]+|wg0\"})",
          "legendFormat": "{{job}}/{{instance}} {{device}}"
        }
      ],
      "options": {
        "rowHeight": 0.8
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Device receive traffic",
      "description": "Shows VLAN (trunk.N), VXLAN and WireGuard devices; VXLAN and WireGuard count tunnelled traffic without its outer IP/UDP headers. Bridges are left out because their counters miss bridged frames.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "min": 0,
          "custom": {
            "showPoints": "never"
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_network_receive_bytes_total{job=~\"$job\", instance=~\"$instance\", device=~\"vxlan[0-9]+|trunk[.][0-9]+|wg0\"}[$__rate_interval]) * 8",
          "legendFormat": "{{job}}/{{instance}} {{device}}"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Device transmit traffic",
      "description": "Shows VLAN (trunk.N), VXLAN and WireGuard devices; VXLAN and WireGuard count tunnelled traffic without its outer IP/UDP headers. Bridges are left out because their counters miss bridged frames.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "min": 0,
          "custom": {
            "showPoints": "never"
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_network_transmit_bytes_total{job=~\"$job\", instance=~\"$instance\", device=~\"vxlan[0-9]+|trunk[.][0-9]+|wg0\"}[$__rate_interval]) * 8",
          "legendFormat": "{{job}}/{{instance}} {{device}}"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Overlay path RTT",
      "description": "Average RTT of 3 echo replies from the configured overlay address every 30s. Gaps mean fewer than 3 replies in 5s or a textfile older than 60s.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "showPoints": "never"
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ega_path_probe_rtt_seconds{job=~\"$job\", instance=~\"$instance\"} and on(job, instance) (node_time_seconds{job=~\"$job\", instance=~\"$instance\"} - on(job, instance) node_textfile_mtime_seconds{job=~\"$job\", instance=~\"$instance\", file=~\".*/ega-path-probe[.]prom\"} < 60)",
          "legendFormat": "{{job}}/{{instance}} {{target}}"
        }
      ]
    }
  ]
}
