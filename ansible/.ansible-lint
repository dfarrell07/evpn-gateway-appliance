---
profile: production

exclude_paths:
  # Jinja template, not valid YAML, so ansible-lint cannot parse it.
  - inventory/hosts.yml.j2
  # Runtime-generated WireGuard key cache; never committed.
  - .wg-keys/
  # Molecule CI scenarios, run by Prow's molecule job and not shipped (galaxy.yml
  # build_ignore); excluded so a bare `ansible-lint` run covers shipped content only.
  - extensions/
