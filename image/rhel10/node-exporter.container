[Container]
Image=registry.redhat.io/openshift4/ose-prometheus-node-exporter-rhel9@sha256:7d2884dc16f902e31b897d475d3e0dc09bc735df16b22544d0fefc4396a0ca48
Network=host
Volume=/proc:/host/proc:ro
Volume=/sys:/host/sys:ro
Volume=/:/rootfs:ro
Exec=--path.procfs=/host/proc --path.sysfs=/host/sys --path.rootfs=/rootfs --web.listen-address=127.0.0.1:9100
GlobalArgs=--storage-opt=additionalimagestore=/usr/lib/bootc/storage
ContainerName=node_exporter

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
