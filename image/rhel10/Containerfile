# FRR from the frr RPM. frr-metrics built from the github.com/metallb/frr-k8s version pinned in frr-metrics/go.mod.
# node_exporter copied from the OpenShift node-exporter image.
#   REGISTRY_AUTH_FILE=... podman build -f Containerfile --build-arg BOOTC_BASE=... .
ARG BOOTC_BASE=registry.redhat.io/rhel10/rhel-bootc
ARG GO_BUILDER=registry.access.redhat.com/ubi10/go-toolset:1.27@sha256:05f3da136a4dbe077f30606e2e53a4f5cab185989c98309823ea06a9a1c52a50
ARG NODE_EXPORTER_IMAGE=registry.redhat.io/openshift4/ose-prometheus-node-exporter-rhel9@sha256:7d2884dc16f902e31b897d475d3e0dc09bc735df16b22544d0fefc4396a0ca48

FROM ${GO_BUILDER} AS frr-metrics-build
COPY frr-metrics /src
WORKDIR /src
RUN go build -trimpath -o /tmp/frr-metrics github.com/metallb/frr-k8s/cmd/metrics

FROM ${NODE_EXPORTER_IMAGE} AS node-exporter

FROM ${BOOTC_BASE}

# Package versions are not pinned; they follow the base image's repositories.
# hadolint ignore=DL3041
RUN dnf install -y \
    wireguard-tools \
    libreswan \
    tcpdump \
    traceroute \
    mtr \
    bind-utils \
    python3 \
    iproute \
    nmstate \
    podman \
    skopeo \
    openssh-server \
    cloud-init \
    frr \
    && dnf clean all

RUN sed -i -e 's/^bgpd=no/bgpd=yes/' -e 's/^bfdd=no/bfdd=yes/' /etc/frr/daemons

COPY --from=frr-metrics-build --chown=0:0 /tmp/frr-metrics /usr/bin/frr-metrics
COPY --from=node-exporter /bin/node_exporter /usr/bin/node_exporter

RUN cat > /etc/sysctl.d/99-ip-forward.conf <<'EOF'
net.ipv4.ip_forward = 1
net.ipv4.conf.all.forwarding = 1
EOF

RUN mkdir -p /etc/wireguard && chmod 700 /etc/wireguard

COPY node-exporter.service frr-metrics.service /etc/systemd/system/

RUN systemctl enable frr.service frr-metrics.service node-exporter.service

LABEL description="EVPN Migration Appliance"
LABEL version="0.1.0"
LABEL prototype=frr-rpm
