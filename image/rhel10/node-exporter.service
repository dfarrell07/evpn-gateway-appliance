[Unit]
Description=Prometheus Node Exporter
After=payload-load.service
Requires=payload-load.service

[Service]
Type=simple
Restart=always
RestartSec=10
ExecStartPre=/usr/bin/mkdir -p /var/lib/node_exporter/textfile
ExecStartPre=-/usr/bin/podman rm -f node_exporter
ExecStart=/usr/bin/podman run \
    --pull=never \
    --name node_exporter \
    --network host \
    --rm \
    -v /proc:/host/proc:ro \
    -v /sys:/host/sys:ro \
    -v /:/rootfs:ro \
    -v /var/lib/node_exporter/textfile:/var/lib/node_exporter/textfile:ro,z \
    node-exporter:embedded \
    --path.procfs=/host/proc \
    --path.sysfs=/host/sys \
    --path.rootfs=/rootfs \
    --collector.textfile.directory=/var/lib/node_exporter/textfile \
    --web.listen-address=127.0.0.1:9100 \
    --no-collector.accelerator
ExecStop=/usr/bin/podman stop node_exporter

[Install]
WantedBy=multi-user.target
